  "validation": {
    "enabled": true,
    "strict": true,
    "tolerance": 0.0,
    "write_back_sheet": true,
    "write_back_sheet_name": "验证结果",
    "column_sum_checks": [
      {
        "column": "deduction_total"
      },
      {
        "column": "personal_tax"
      },
      {
        "column": "adjustment"
      },
      {
        "column": "pay_cash"
      },
      {
        "column": "net_total"
      },
      {
        "column": "tax_and_fee"
      }
    ],
    "row_formulas": [
      {
        "name": "转款合计 = 扣款合计 + 个人所得税 + 个人其他调整 + 个人欠款 + 个人承担代理费 + 扣工会会费 - 交纳现金 + 实发工资 + 税费",
        "lhs": "transfer_total",
        "rhs_plus": [
          "deduction_total",
          "personal_tax",
          "adjustment",
          "personal_debt",
          "personal_proxy_fee",
          "union_fee",
          "net_total",
          "tax_and_fee"
        ],
        "rhs_minus": [
          "pay_cash"
        ]
      }
    ],
    "extra_summary_checks": [
      {
        "name": "转款合计 = 溢缴款抵扣 + 甲方转款",
        "column": "transfer_total",
        "lhs_row_key": "summary",
        "rhs_plus_row_keys": [
          "overpayment_offset",
          "party_a_transfer"
        ],
        "rhs_minus_row_keys": []
      }
    ],
    "required_signatures": [
      [
        "总经理签字",
        "财务审核",
        "业务审核"
      ]
    ],
    "rule_sets": {
      "default": {
        "name": "通用规则（默认）",
        "description": "适用于标准工资表模板的通用验证规则",
        "column_sum_checks": [
          {"column": "deduction_total"},
          {"column": "personal_tax"},
          {"column": "adjustment"},
          {"column": "pay_cash"},
          {"column": "net_total"},
          {"column": "tax_and_fee"}
        ],
        "row_formulas": [
          {
            "name": "转款合计 = 扣款合计 + 个人所得税 + 个人其他调整 + 个人欠款 + 个人承担代理费 + 扣工会会费 - 交纳现金 + 实发工资 + 税费",
            "lhs": "transfer_total",
            "rhs_plus": ["deduction_total", "personal_tax", "adjustment", "personal_debt", "personal_proxy_fee", "union_fee", "net_total", "tax_and_fee"],
            "rhs_minus": ["pay_cash"]
          }
        ],
        "extra_summary_checks": [
          {
            "name": "转款合计 = 溢缴款抵扣 + 甲方转款",
            "column": "transfer_total",
            "lhs_row_key": "summary",
            "rhs_plus_row_keys": ["overpayment_offset", "party_a_transfer"],
            "rhs_minus_row_keys": []
          }
        ]
      },
      "jilin_outsourcing": {
        "name": "外包业务规则（外包人员工资发放表）",
        "description": "适用于合计行下方带管理费/税费/外包费用转款合计的外包人员工资发放表（如吉林农商行）",
        "detect": {
          "title_keywords": ["外包人员工资发放表"],
          "unit_keywords": [],
          "header_keywords": ["cost_total", "gross_total"]
        },
        "column_sum_checks": [
          {"column": "cost_total"},
          {"column": "gross_total"},
          {"column": "unit_social_total"},
          {"column": "deduction_total"},
          {"column": "personal_tax"},
          {"column": "net_total"}
        ],
        "row_formulas": [
          {
            "name": "成本合计 = 扣款合计 + 个人所得税 + 实发工资 + 个人欠款 + 个人承担代理费 + 扣工会会费 + 个人其他调整 - 交纳现金",
            "lhs": "cost_total",
            "rhs_plus": ["deduction_total", "personal_tax", "net_total", "personal_debt", "personal_proxy_fee", "union_fee", "adjustment"],
            "rhs_minus": ["pay_cash"]
          },
          {
            "name": "应发合计 = 基本工资 + 加班费 + 岗位补贴 + 补助 + 差旅费",
            "lhs": "gross_total",
            "rhs_plus": ["base_salary", "overtime_pay", "post_subsidy", "meal_subsidy", "travel_allowance"],
            "rhs_minus": []
          },
          {
            "name": "成本合计 = 应发合计 + 单位缴纳五险一金",
            "lhs": "cost_total",
            "rhs_plus": ["gross_total", "unit_social_total"],
            "rhs_minus": []
          }
        ],
        "cross_row_formulas": [
          {
            "name": "外包费用转款合计 = 成本合计 + 管理费 + 税费",
            "lhs": {"row_key": "outsourcing_transfer_total", "source": "row_value"},
            "rhs_plus": [
              {"row_key": "summary", "source": "column", "column": "cost_total"},
              {"row_key": "management_fee", "source": "row_value"},
              {"row_key": "tax_fee", "source": "row_value"}
            ],
            "rhs_minus": []
          }
        ],
        "percent_checks": [
          {
            "name": "管理费 = 成本合计 × 3.5%",
            "target": {"row_key": "management_fee", "source": "row_value"},
            "base": [{"row_key": "summary", "source": "column", "column": "cost_total"}],
            "rate": 0.035,
            "tolerance": 0.01
          },
          {
            "name": "税费 = (成本合计 + 管理费) × 6%",
            "target": {"row_key": "tax_fee", "source": "row_value"},
            "base": [
              {"row_key": "summary", "source": "column", "column": "cost_total"},
              {"row_key": "management_fee", "source": "row_value"}
            ],
            "rate": 0.06,
            "tolerance": 0.01
          }
        ]
      }
    },
    "auto_detect": {
      "enabled": true,
      "fallback_to_default": true
    }
  },
