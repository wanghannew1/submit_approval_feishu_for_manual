# Feishu API Credentials
FEISHU_APP_ID=your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here
# 审批流程 code（手工做表版独立审批流）。真实 definitionCode 请放入 .env 文件（已被 .gitignore 忽略，不会进仓库）
FEISHU_APPROVAL_CODE=your_approval_code_here
# 外包业务手工工资单审批流程 code（外包人员工资发放表走这条流程）
FEISHU_APPROVAL_CODE_OUTSOURCING=your_outsourcing_approval_code_here
FEISHU_USER_ID_TYPE=open_id